<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#121212"><title>Studio Notes</title>
<style>
:root{color-scheme:dark;--bg:#101114;--panel:#1a1c22;--panel2:#232630;--line:#343744;--text:#f4f4f5;--muted:#a5a8b4;--accent:#c6f36a;--danger:#ff8b8b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.45 system-ui,-apple-system,Segoe UI,sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer;border:1px solid var(--line);border-radius:12px;background:var(--panel2);color:var(--text);padding:10px 13px}button.primary{background:var(--accent);color:#15170f;border-color:var(--accent);font-weight:750}button:disabled{opacity:.45;cursor:default}.app{max-width:900px;margin:auto;padding:16px 14px 42px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.brand{font-size:22px;font-weight:850;letter-spacing:-.6px}.brand span{color:var(--accent)}.sub{font-size:12px;color:var(--muted)}.tabs{display:flex;gap:8px;overflow:auto;margin-bottom:14px}.tabs button{white-space:nowrap}.tabs button.active{border-color:var(--accent);color:var(--accent)}.layout{display:grid;grid-template-columns: minmax(190px, .72fr) minmax(0,1.7fr);gap:14px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:14px;min-width:0}.panel h2,.panel h3{margin:0 0 12px}.panel h2{font-size:18px}.panel h3{font-size:15px}.row{display:flex;gap:8px;align-items:center}.row>*{min-width:0}.between{justify-content:space-between}.stack{display:flex;flex-direction:column;gap:10px}.field{width:100%;background:#111318;color:var(--text);border:1px solid var(--line);border-radius:11px;padding:11px;outline:none}.field:focus{border-color:var(--accent)}textarea.field{resize:vertical;min-height:300px;line-height:1.65}.small{font-size:12px;color:var(--muted)}.songlist{display:flex;flex-direction:column;gap:7px}.songitem{text-align:left;width:100%;background:#14161b;padding:11px}.songitem.selected{border-color:var(--accent)}.songitem strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.songitem small{color:var(--muted)}.hidden{display:none!important}.section{margin-top:14px}.pill{display:inline-block;border:1px solid var(--line);border-radius:99px;padding:3px 8px;font-size:11px;color:var(--muted)}.recording{color:var(--danger)}.imagegrid{display:flex;flex-wrap:wrap;gap:8px}.imagegrid img{width:90px;height:110px;object-fit:cover;border-radius:10px;border:1px solid var(--line)}.memo{background:#14161b;border:1px solid var(--line);border-radius:12px;padding:10px;display:flex;gap:8px;align-items:center;justify-content:space-between}.memo audio{width:100%;max-width:270px;height:36px}.helpergrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.result{background:#111318;border:1px solid var(--line);padding:10px;border-radius:11px;min-height:44px;white-space:pre-wrap;overflow-wrap:anywhere}.footer{margin-top:14px;color:var(--muted);font-size:12px}.wordtools{display:flex;gap:7px;flex-wrap:wrap}.wordtools button{padding:8px 10px}.mobileonly{display:none}@media(max-width:650px){.layout{grid-template-columns:1fr}.sidebar{order:2}.editor{order:1}.songlist{display:grid;grid-template-columns:1fr 1fr}.songitem{min-width:0}.songitem strong{max-width:100%}textarea.field{min-height:260px}.top{align-items:flex-start}.helpergrid{grid-template-columns:1fr}.desktoponly{display:none}.mobileonly{display:block}}
</style></head><body><div class="app">
<header class="top"><div><div class="brand">STUDIO <span>NOTES</span></div><div class="sub">Your private songwriting space · saved on this device</div></div><button id="newBtn" class="primary">＋ New idea</button></header>
<nav class="tabs"><button class="active" data-tab="write">✍️ Write</button><button data-tab="recordings">🎙 Recordings</button><button data-tab="words">✦ Word helper</button><button data-tab="backup">↗ Backup & privacy</button></nav>
<div id="writeTab" class="layout">
<aside class="panel sidebar"><div class="row between"><h2>Your notebook</h2><span class="pill" id="count">0 ideas</span></div><input id="search" class="field" placeholder="Find a song or idea…"><div class="section songlist" id="songList"></div><p class="small">Start messy. Organize when you're ready.</p></aside>
<main class="panel editor"><div class="stack"><input id="songTitle" class="field" placeholder="Song title or random thought…" aria-label="Title"><div class="row"><select id="kind" class="field" style="width:auto;flex:1"><option>Song</option><option>Hook</option><option>Verse</option><option>Voice idea</option><option>Random thought</option></select><input id="tags" class="field" placeholder="Tags (optional)" style="flex:1"></div><textarea id="lyrics" class="field" placeholder="Put the words here… no format needed.\n\nTip: select a word and open Word helper."></textarea><div class="row between"><span class="small" id="saveState">Saved on this device</span><button id="saveBtn" class="primary">Save</button></div></div>
<div class="section"><h3>Handwritten lyrics / inspiration</h3><div class="row"><label for="images" class="field" style="display:block;cursor:pointer;text-align:center">＋ Add photos</label><input id="images" type="file" accept="image/*" multiple class="hidden"></div><div class="imagegrid section" id="imageGrid"></div></div>
<div class="section"><div class="row between"><h3>Voice ideas</h3><span class="small" id="recStatus">Ready when you are</span></div><div class="row" style="flex-wrap:wrap"><button id="recordBtn" class="primary">● Record</button><button id="stopBtn" disabled>■ Stop</button><button id="playLatestBtn" disabled>▶ Latest take</button></div><div id="memoList" class="stack section"></div><p class="small">Keep this page open while recording. Allow microphone access if asked.</p></div>
</main></div>
<section id="recordingsTab" class="panel hidden"><h2>All recordings</h2><p class="small">Recordings are attached to the idea they belong to.</p><div id="allMemos" class="stack"></div></section>
<section id="wordsTab" class="panel hidden"><h2>Word helper</h2><p class="small">A quick, built-in word toolbox. No AI account, no API key, no usage fees. It works best for common English words and phrases.</p><label class="small" for="targetWord">Word or phrase (or select text in your lyrics and tap “Use selected word”)</label><div class="row section"><input id="targetWord" class="field" placeholder="e.g. lonely, electric, stay"><button id="selectedBtn">Use selected word</button></div><div class="wordtools section"><button data-tool="rhymes">Rhymes</button><button data-tool="near">Near rhymes</button><button data-tool="synonyms">Similar words</button><button data-tool="spell">Spelling check</button><button data-tool="syllables">Syllables</button><button data-tool="ideas">Lyric prompts</button></div><div class="section"><h3 id="helperTitle">Your results</h3><div id="helperResult" class="result">Type a word, then choose a tool.</div></div><div class="section"><h3>Creative note</h3><p class="small">This helper is intentionally lightweight. It doesn't send your words anywhere. For deeper feedback, you can copy a line into ChatGPT separately when you choose to.</p></div></section>
<section id="backupTab" class="panel hidden"><h2>Backups & privacy</h2><p>Studio Notes is designed to keep your writing in this browser on this phone. It does not include analytics, sign-in, cloud sync, or an AI API.</p><div class="stack section"><button class="primary" id="exportBtn">Export backup file</button><label class="field" style="display:block;cursor:pointer;text-align:center">Import backup file<input id="importFile" type="file" accept="application/json,.json" class="hidden"></label><button id="clearBtn">Delete all local data…</button></div><div class="section result"><strong>Important:</strong> Browser storage can be cleared by device cleanup, browser settings, or uninstalling/clearing app data. Export backups regularly. If you open this as a hosted web app, the hosting provider serves the app code, but your lyrics and recordings remain on your device unless you explicitly export or share them.</div><p class="small section">For reliable microphone recording, open the app from a secure HTTPS address in Chrome or Samsung Internet. A downloaded HTML file may have browser-specific microphone limitations.</p></section>
<div class="footer">Studio Notes · local-first prototype · no account required</div></div>
<script>
const DB='studio-notes-db-v1', STORE='items';let db,items=[],current=null,mediaRecorder=null,stream=null,chunks=[],lastBlob=null,recordStarted=0,activeTab='write';
const $=id=>document.getElementById(id);function openDB(){return new Promise((resolve,reject)=>{const r=indexedDB.open(DB,1);r.onupgradeneeded=()=>{r.result.createObjectStore(STORE,{keyPath:'id'})};r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error)})}function all(){return new Promise((resolve,reject)=>{const r=db.transaction(STORE).objectStore(STORE).getAll();r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error)})}function put(item){return new Promise((resolve,reject)=>{const tx=db.transaction(STORE,'readwrite');tx.objectStore(STORE).put(item);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)})}function del(id){return new Promise((resolve,reject)=>{const tx=db.transaction(STORE,'readwrite');tx.objectStore(STORE).delete(id);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)})}function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,8)}function fresh(){return {id:uid(),title:'',kind:'Song',tags:'',lyrics:'',images:[],memos:[],updated:Date.now()}}function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
async function refresh(){items=(await all()).sort((a,b)=>b.updated-a.updated);renderList();renderMemos();renderAllMemos();$('count').textContent=items.length+' idea'+(items.length===1?'':'s')}
function renderList(){const q=$('search').value.toLowerCase();$('songList').innerHTML=items.filter(x=>(x.title+' '+x.lyrics+' '+x.tags).toLowerCase().includes(q)).map(x=>`<button class="songitem ${x.id===current?'selected':''}" data-id="${x.id}"><strong>${esc(x.title||'Untitled idea')}</strong><small>${esc(x.kind||'Song')} · ${new Date(x.updated).toLocaleDateString()}</small></button>`).join('')||'<p class="small">No ideas yet. Tap “New idea”.</p>';document.querySelectorAll('.songitem').forEach(b=>b.onclick=()=>loadSong(b.dataset.id))}
function loadSong(id){current=items.find(x=>x.id===id)||null;if(!current)return;$('songTitle').value=current.title||'';$('kind').value=current.kind||'Song';$('tags').value=current.tags||'';$('lyrics').value=current.lyrics||'';renderList();renderImages();renderMemos();$('saveState').textContent='Saved on this device'}async function saveSong(){if(!current)current=fresh();current.title=$('songTitle').value;current.kind=$('kind').value;current.tags=$('tags').value;current.lyrics=$('lyrics').value;current.updated=Date.now();await put(current);await refresh();$('saveState').textContent='Saved just now'}async function newSong(){await saveSongIfNeeded();current=fresh();await put(current);await refresh();loadSong(current.id);$('songTitle').focus()}async function saveSongIfNeeded(){if(current)await saveSong()}
function renderImages(){const imgs=current?.images||[];$('imageGrid').innerHTML=imgs.map((im,i)=>`<div style="position:relative"><img src="${im.data}" alt="Imported lyric photo"><button data-img="${i}" title="Remove photo" style="position:absolute;right:3px;top:3px;padding:2px 7px">×</button></div>`).join('');document.querySelectorAll('[data-img]').forEach(b=>b.onclick=async()=>{current.images.splice(+b.dataset.img,1);await saveSong();renderImages()})}
$('images').onchange=async e=>{if(!current)await newSong();for(const f of e.target.files){if(!f.type.startsWith('image/'))continue;if(f.size>12*1024*1024){alert('That image is larger than 12 MB. Choose a smaller photo to keep local storage manageable.');continue}const data=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=()=>reject(r.error);r.readAsDataURL(f)});current.images.push({name:f.name,data})}try{await saveSong();renderImages()}catch(err){alert('Could not save the photo. Export your backup and try a smaller image.')}e.target.value=''};
function renderMemos(){const memos=current?.memos||[];$('memoList').innerHTML=memos.map((m,i)=>`<div class="memo"><div style="flex:1;min-width:0"><div><strong>${esc(m.name||'Take '+(i+1))}</strong> <span class="small">${esc(m.date||'')}</span></div><audio controls preload="metadata" src="${m.url||URL.createObjectURL(m.blob)}"></audio></div><button data-memo="${i}" title="Delete take">×</button></div>`).join('')||'<p class="small">No recordings yet. Capture the idea before it disappears.</p>';document.querySelectorAll('[data-memo]').forEach(b=>b.onclick=async()=>{current.memos.splice(+b.dataset.memo,1);await saveSong();renderMemos()});$('playLatestBtn').disabled=!memos.length}
function renderAllMemos(){let arr=[];items.forEach(s=>(s.memos||[]).forEach(m=>arr.push({s,m})));$('allMemos').innerHTML=arr.map(({s,m})=>`<div class="memo"><div style="flex:1;min-width:0"><strong>${esc(s.title||'Untitled idea')} · ${esc(m.name||'Take')}</strong><div class="small">${esc(m.date||'')}</div><audio controls preload="metadata" src="${m.url||URL.createObjectURL(m.blob)}"></audio></div></div>`).join('')||'<p class="small">No recordings yet.</p>'}
$('newBtn').onclick=newSong;$('saveBtn').onclick=saveSong;$('search').oninput=renderList;['songTitle','kind','tags','lyrics'].forEach(id=>$(id).addEventListener('input',()=>{$('saveState').textContent='Unsaved changes';clearTimeout(window.autosave);window.autosave=setTimeout(saveSong,650)}));
$('recordBtn').onclick=async()=>{try{if(!current)await newSong();if(!navigator.mediaDevices?.getUserMedia||!window.MediaRecorder){alert('Recording needs a compatible browser and a secure HTTPS address. Try Chrome or Samsung Internet.');return}stream=await navigator.mediaDevices.getUserMedia({audio:true});chunks=[];const mimeCandidates=['audio/webm;codecs=opus','audio/webm','audio/mp4','audio/ogg;codecs=opus'];const mimeType=mimeCandidates.find(t=>MediaRecorder.isTypeSupported?.(t));mediaRecorder=mimeType?new MediaRecorder(stream,{mimeType}):new MediaRecorder(stream);mediaRecorder.ondataavailable=e=>{if(e.data&&e.data.size)chunks.push(e.data)};mediaRecorder.onerror=()=>{stream?.getTracks().forEach(t=>t.stop());stream=null;$('recStatus').textContent='Recording failed. Try again.';$('recordBtn').disabled=false;$('stopBtn').disabled=true};mediaRecorder.onstop=async()=>{try{const blob=new Blob(chunks,{type:mediaRecorder.mimeType||mimeType||'audio/webm'});if(!blob.size){$('recStatus').textContent='Empty recording. Please try again.';return}current.memos=current.memos||[];current.memos.push({name:'Take '+(current.memos.length+1),date:new Date().toLocaleString(),blob});current.updated=Date.now();await put(current);await refresh();loadSong(current.id);$('recStatus').textContent='Take saved on this device'}catch(err){$('recStatus').textContent='Could not save this take. Export a backup and check phone storage.';alert('The recording was captured, but saving failed. Check available storage and try again.')}finally{stream?.getTracks().forEach(t=>t.stop());stream=null;chunks=[];$('recordBtn').disabled=false;$('stopBtn').disabled=true;$('recStatus').classList.remove('recording')}};mediaRecorder.start(250);recordStarted=Date.now();$('recStatus').textContent='Recording…';$('recStatus').classList.add('recording');$('recordBtn').disabled=true;$('stopBtn').disabled=false}catch(e){stream?.getTracks().forEach(t=>t.stop());stream=null;$('recStatus').textContent='Microphone unavailable';$('recordBtn').disabled=false;$('stopBtn').disabled=true;alert(e?.name==='NotAllowedError'?'Microphone access was denied. Allow it in your browser settings and try again.':'Microphone could not be started. Open the hosted HTTPS app in Chrome or Samsung Internet and try again.')}};$('stopBtn').onclick=()=>{if(mediaRecorder&&mediaRecorder.state!=='inactive')mediaRecorder.stop()};$('playLatestBtn').onclick=()=>{const m=current?.memos?.at(-1);if(m){const a=new Audio(m.url||URL.createObjectURL(m.blob));a.play().catch(()=>alert('Could not play this recording in the current browser.'))}};
function tab(name){activeTab=name;document.querySelectorAll('[data-tab]').forEach(b=>b.classList.toggle('active',b.dataset.tab===name));['write','recordings','words','backup'].forEach(t=>$(t+'Tab').classList.toggle('hidden',t!==name+'Tab'));if(name==='recordings')renderAllMemos()}document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>tab(b.dataset.tab));$('selectedBtn').onclick=()=>{const a=$('lyrics'),s=a.value.slice(a.selectionStart,a.selectionEnd).trim();if(s)$('targetWord').value=s};
const rhyme={love:'above dove glove shove',heart:'start part art apart smart',time:'rhyme climb sublime chime',night:'light fight sight right flight',fire:'desire higher wire inspire',pain:'rain stain chain again',alone:'home roam known stone',dream:'scheme beam seem theme',mind:'find kind blind rewind',feel:'real deal heal steel',stay:'away today decay replay',blue:'you true through new',life:'strife knife wife alive',cold:'hold told old gold',eyes:'skies lies rise surprise',way:'say play day gray',run:'sun done one begun',fall:'call all wall crawl',free:'me be see key',change:'strange range exchange',sound:'ground found round profound',ghost:'most coast close almost',head:'dead said red bed',down:'town crown drown sound',more:'door floor before explore',back:'track black crack stack',slow:'go flow know show',high:'sky fly try why',broken:'spoken open hoping',wait:'late fate straight create',skin:'in begin within sin',mind:'kind find signed'};
const synonyms={sad:'blue, down, heavy-hearted, low, hollow, aching',happy:'bright, alive, glowing, lifted, joyful, weightless',love:'devotion, desire, affection, longing, passion, tenderness',lonely:'isolated, distant, unseen, abandoned, solitary, disconnected',angry:'furious, bitter, heated, restless, resentful, burning',beautiful:'radiant, vivid, graceful, striking, luminous, lovely',dark:'shadowed, midnight, hidden, dim, bleak, pitch-black',good:'solid, golden, worthy, graceful, brilliant, genuine',bad:'rough, broken, bitter, crooked, hollow, heavy',fast:'rapid, rushing, racing, swift, frantic, accelerated',slow:'steady, dragging, drifting, gradual, crawling, unhurried',strong:'resilient, fierce, sturdy, unshaken, powerful, grounded',fear:'dread, panic, doubt, worry, terror, unease',hope:'faith, promise, belief, possibility, light, expectation',beautiful:'radiant, vivid, graceful, striking, luminous, lovely'};
const known=new Set(('about above across act add after again against age ago air all almost alone along already also always am an and anger angry animal another answer any anyone anything are around as ask at away back bad be beautiful because become been before begin behind believe below best better between big bird black blue body book both bring brother build burn but buy by call came can car care carry change child city close cold come could country cut dark day dead deal dear death did different do does dog done door down dream drink drive each early earth easy eat end enough even ever every eye face fact fall family far fast father feel few fight find first fire five fly follow food for force forget free friend from full fun game gave get girl give go good great green ground group grow guess guy had hand happen happy hard has have head hear heart heat help her here high him his home hope hot house how human hurt i idea if in inside into is it its job just keep kind know land last late laugh learn leave left less let life light like line listen little live long look lose lot love low make man many may me mean mind miss money more most mother move much music must my name near need never new next night no not nothing now number of off often old on once one only open or other our out over own paper part people person place play point power pretty put question quick quiet rain read real reason red remember rest right river road rock room run said same saw say school sea second see seem sentence set she shine should show side simple since sing sister sit sky sleep small so some someone something song sound space speak spend stand start stay still stop story strong such sun sure take talk tell than that the their them then there these they thing think this those thought through time to today together too took toward try turn two under understand until up us use very voice wait walk want was watch water way we well went were what when where which while white who why will wind with without woman word work world worry would write wrong year yellow yes yet you young your').split(' '));
function tool(name){let w=$('targetWord').value.trim().toLowerCase(),out='',title='';if(!w){$('helperResult').textContent='Enter a word or phrase first.';return}if(name==='rhymes'||name==='near'){title=name==='rhymes'?'Rhymes':'Near rhymes';let exact=rhyme[w]||Object.entries(rhyme).find(([k])=>k.endsWith(w.slice(-3)))?.[1]||'';out=exact?exact.split(' ').join(', '):'No exact matches in the small built-in list. Try a shorter word or use a slant rhyme.';if(name==='near')out+='\n\nTry sound families, repeated vowels, or matching the last stressed syllable.'}else if(name==='synonyms'){title='Similar words';out=synonyms[w]||'Try a related feeling or image: what does the word look, sound, taste, or feel like?'}else if(name==='spell'){title='Spelling check';if(known.has(w))out='This word is in the built-in common-word list. Check context and punctuation too.';else out='I can’t confirm this spelling with the small offline word list. Try reading it aloud, checking a dictionary, or paste the line into ChatGPT if you want a deeper check.'}else if(name==='syllables'){title='Syllable estimate';out='Estimated syllables: '+(w.match(/[aeiouy]+/g)||[]).length+'\nSay it aloud to confirm. This quick estimate can be wrong for unusual words or names.'}else{title='Lyric prompts';out='• Say the opposite of “'+w+'”.\n• Describe it without naming it.\n• Put it in a specific place or memory.\n• Find a physical object that represents it.\n• Write one honest line, then one exaggerated line.'}$('helperTitle').textContent=title;$('helperResult').textContent=out}
document.querySelectorAll('[data-tool]').forEach(b=>b.onclick=()=>tool(b.dataset.tool));
$('exportBtn').onclick=async()=>{await saveSongIfNeeded();const data=await all();const exported=[];for(const s of data){const copy={...s,memos:[]};for(const m of (s.memos||[])){const blob=m.blob||(m.url?await (await fetch(m.url)).blob():new Blob());copy.memos.push({name:m.name,date:m.date,blobData:await blobToData(blob)})}exported.push(copy)}const payload={app:'Studio Notes',version:1,exported:new Date().toISOString(),items:exported};const blob=new Blob([JSON.stringify(payload)],{type:'application/json'});download(blob,'studio-notes-backup-'+new Date().toISOString().slice(0,10)+'.json')};function blobToData(blob){return new Promise(res=>{const r=new FileReader();r.onload=()=>res(r.result);r.readAsDataURL(blob)})}function download(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
$('importFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const p=JSON.parse(await f.text());for(const s of p.items||[]){s.memos=(s.memos||[]).map(m=>{if(m.blobData){const [meta,b64]=m.blobData.split(',');const mime=meta.match(/:(.*?);/)[1];const bytes=atob(b64);const arr=new Uint8Array(bytes.length);for(let i=0;i<bytes.length;i++)arr[i]=bytes.charCodeAt(i);m.blob=new Blob([arr],{type:mime});delete m.blobData}return m});await put(s)}await refresh();alert('Backup imported. Your ideas are now in this browser.')}catch(err){alert('Could not import that backup file.')}e.target.value=''};$('clearBtn').onclick=async()=>{if(confirm('Delete every song, image and recording stored by Studio Notes in this browser? Export a backup first if you want to keep them.')){const tx=db.transaction(STORE,'readwrite');tx.objectStore(STORE).clear();tx.oncomplete=async()=>{current=null;await refresh();await newSong();alert('Local Studio Notes data cleared.')}}};
(async()=>{try{db=await openDB();await refresh();if(items.length)loadSong(items[0].id);else await newSong();if(navigator.storage?.persist){navigator.storage.persist().then(granted=>{if(!granted){const note=document.createElement('p');note.className='small';note.textContent='Tip: this browser has not granted persistent storage. Use Export backup regularly.';$('backupTab').appendChild(note)}})}}catch(e){alert('Local storage could not be opened in this browser. Try Chrome or Samsung Internet.')}})();
</script></body></html>